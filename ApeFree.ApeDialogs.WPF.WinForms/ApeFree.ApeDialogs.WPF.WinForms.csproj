<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup> 
<TargetFrameworks>net452;net461;net472;net6.0-windows;net8.0-windows;net10.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <Company>ApeFree</Company>
    <Authors>Guijie Lee</Authors>
    <Copyright>Copyright © 2022-2026 ApeFree, All Rights Reserved.</Copyright>
    <Title>ApeDialogs.WPF.WinForms</Title>
    <Product>ApeFree.ApeDialogs.WPF.WinForms</Product>
    <Description>在 WinForms 应用中使用 ApeFree.ApeDialogs.WPF 的桥接包（FormOwner + Form 扩展方法）。</Description>
    <RepositoryUrl>https://github.com/ApeFree/ApeFree.ApeDialogs</RepositoryUrl>
    <PackageProjectUrl>https://github.com/ApeFree/ApeFree.ApeDialogs</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>ApeFree_64px.png</PackageIcon>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>

    <Version>1.1.0.0-alpha61112</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <Deterministic>true</Deterministic>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <NoWarn>$(NoWarn);1591;CA1510;CA1707</NoWarn>
		<GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">true</GeneratePackageOnBuild>
	</PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ApeFree.ApeDialogs.WPF\ApeFree.ApeDialogs.WPF.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\ApeFree_64px.png" Pack="true" PackagePath="\" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>