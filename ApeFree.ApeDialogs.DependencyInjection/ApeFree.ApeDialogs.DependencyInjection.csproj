<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>

    <Company>ApeFree</Company>
    <Authors>Guijie Lee</Authors>
    <Copyright>Copyright © 2022-2026 ApeFree, All Rights Reserved.</Copyright>
    <Title>ApeDialogs.DependencyInjection</Title>
    <Product>ApeFree.ApeDialogs.DependencyInjection</Product>
    <Description>ApeDialogs 的 Microsoft.Extensions.DependencyInjection 集成包，用于注册 DialogProvider。</Description>
    <RepositoryUrl>https://github.com/ApeFree/ApeFree.ApeDialogs</RepositoryUrl>
    <PackageProjectUrl>https://github.com/ApeFree/ApeFree.ApeDialogs</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>ApeFree_64px.png</PackageIcon>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>

    <Version>1.0.0</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <Deterministic>true</Deterministic>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- CA1510 在 netstandard2.0 不存在，统一保留显式判空写法 -->
    <NoWarn>$(NoWarn);1591;CA1510</NoWarn>
		<GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">true</GeneratePackageOnBuild>
	</PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ApeFree.ApeDialogs\ApeFree.ApeDialogs.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\ApeFree_64px.png" Pack="true" PackagePath="\" />
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>