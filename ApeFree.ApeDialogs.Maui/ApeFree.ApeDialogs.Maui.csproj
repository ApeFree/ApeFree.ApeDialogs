<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0-android</TargetFrameworks>
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux')) and '$(BuildAppleTarget)' == 'true'">$(TargetFrameworks);net8.0-ios;net8.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net8.0-windows10.0.19041.0</TargetFrameworks>
		<CheckEolWorkloads>false</CheckEolWorkloads>

		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>

		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>

		<Company>ApeFree</Company>
		<Authors>Guijie Lee</Authors>
		<Copyright>Copyright © 2022-2026 ApeFree, All Rights Reserved.</Copyright>
		<Title>ApeDialogs.Maui</Title>
		<Product>ApeFree.ApeDialogs.Maui</Product>
		<Description>ApeDialogs 的 .NET MAUI 实现库，遵循 ApeDialog 规范，支持 Android、iOS、macOS 与 Windows 统一跨平台对话框体验。</Description>
		<RepositoryUrl>https://github.com/ApeFree/ApeFree.ApeDialogs</RepositoryUrl>
		<PackageProjectUrl>https://github.com/ApeFree/ApeFree.ApeDialogs</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>ApeFree_64px.png</PackageIcon>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>

		<Version>1.0.2.1-alpha260907</Version>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>

		<Deterministic>true</Deterministic>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<NoWarn>$(NoWarn);1591;CA1510;CA1707;SYSLIB1054;NETSDK1206;CsWinRT1028;CsWinRT1030;CA1859;CA1305;CA1805</NoWarn>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="8.0.100" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ApeFree.ApeDialogs\ApeFree.ApeDialogs.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\ApeFree_64px.png" Pack="true" PackagePath="\" />
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
