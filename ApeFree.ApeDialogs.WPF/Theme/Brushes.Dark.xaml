<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Win11 Fluent 设计令牌 · 深色 -->

    <!-- 背景层 -->
    <SolidColorBrush x:Key="ApeWindowBackground" Color="#202020" />
    <SolidColorBrush x:Key="ApeCardBackground" Color="#2C2C2C" />
    <SolidColorBrush x:Key="ApeLayerBackground" Color="#3A3A3A" />

    <!-- 控件填充 -->
    <SolidColorBrush x:Key="ApeControlFillDefault" Color="#2C2C2C" />
    <SolidColorBrush x:Key="ApeControlFillSecondary" Color="#333333" />
    <SolidColorBrush x:Key="ApeControlFillTertiary" Color="#3A3A3A" />
    <SolidColorBrush x:Key="ApeControlFillHover" Color="#3A3A3A" />
    <SolidColorBrush x:Key="ApeControlFillPressed" Color="#454545" />
    <SolidColorBrush x:Key="ApeControlFillDisabled" Color="#3A3A3A" />
    <SolidColorBrush x:Key="ApeControlFillInputActive" Color="#2C2C2C" />

    <!-- 文字 -->
    <SolidColorBrush x:Key="ApeTextFillPrimary" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ApeTextFillSecondary" Color="#D0D0D0" />
    <SolidColorBrush x:Key="ApeTextFillTertiary" Color="#9E9E9E" />
    <SolidColorBrush x:Key="ApeTextFillDisabled" Color="#8A8A8A" />
    <SolidColorBrush x:Key="ApeTextFillOnAccent" Color="#000000" />
    <SolidColorBrush x:Key="ApeTextFillOnAccentDisabled" Color="#3E84A8" />

    <!-- 边框 -->
    <SolidColorBrush x:Key="ApeStrokeDefault" Color="#454545" />
    <SolidColorBrush x:Key="ApeStrokeSubtle" Color="#3A3A3A" />
    <SolidColorBrush x:Key="ApeStrokeFocus" Color="#60CDFF" />
    <SolidColorBrush x:Key="ApeStrokeControlActive" Color="#60CDFF" />

    <!-- 强调色 -->
    <SolidColorBrush x:Key="ApeAccentFillDefault" Color="#60CDFF" />
    <SolidColorBrush x:Key="ApeAccentFillSecondary" Color="#6FD3FF" />
    <SolidColorBrush x:Key="ApeAccentFillTertiary" Color="#3AA0DA" />
    <SolidColorBrush x:Key="ApeAccentFillDisabled" Color="#3E84A8" />
    <SolidColorBrush x:Key="ApeAccentTextPrimary" Color="#60CDFF" />
    <SolidColorBrush x:Key="ApeAccentTextDisabled" Color="#3E84A8" />

    <!-- 语义色 -->
    <SolidColorBrush x:Key="ApePositiveBrush" Color="#6CCB5F" />
    <SolidColorBrush x:Key="ApeNegativeBrush" Color="#FF99A4" />
    <SolidColorBrush x:Key="ApeSpecialBrush" Color="#9B8FFF" />
    <SolidColorBrush x:Key="ApeFunctionalBrush" Color="#60CDFF" />

    <!-- 形状与阴影 -->
    <CornerRadius x:Key="ApeOverlayCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="ApeControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="ApeSmallCornerRadius">2</CornerRadius>

    <!-- 字体 -->
    <FontFamily x:Key="ApeDefaultFontFamily">Segoe UI Variable, Segoe UI</FontFamily>
    <sys:Double x:Key="ApeTitleFontSize" xmlns:sys="clr-namespace:System;assembly=mscorlib">24</sys:Double>
    <sys:Double x:Key="ApeCaptionFontSize" xmlns:sys="clr-namespace:System;assembly=mscorlib">20</sys:Double>
    <sys:Double x:Key="ApeBodyFontSize" xmlns:sys="clr-namespace:System;assembly=mscorlib">14</sys:Double>
    <sys:Double x:Key="ApeCaptionTextFontSize" xmlns:sys="clr-namespace:System;assembly=mscorlib">12</sys:Double>
    <sys:Double x:Key="ApeSubtextFontSize" xmlns:sys="clr-namespace:System;assembly=mscorlib">12</sys:Double>

</ResourceDictionary>
