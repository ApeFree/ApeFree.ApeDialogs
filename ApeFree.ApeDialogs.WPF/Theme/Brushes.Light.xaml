<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Win11 Fluent 设计令牌 · 浅色 -->

    <!-- 背景层 -->
    <SolidColorBrush x:Key="ApeWindowBackground" Color="#F3F3F3" />
    <SolidColorBrush x:Key="ApeCardBackground" Color="#F9F9F9" />
    <SolidColorBrush x:Key="ApeLayerBackground" Color="#FFFFFF" />

    <!-- 控件填充 -->
    <SolidColorBrush x:Key="ApeControlFillDefault" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ApeControlFillSecondary" Color="#F9F9F9" />
    <SolidColorBrush x:Key="ApeControlFillTertiary" Color="#F3F3F3" />
    <SolidColorBrush x:Key="ApeControlFillHover" Color="#E5E5E5" />
    <SolidColorBrush x:Key="ApeControlFillPressed" Color="#D9D9D9" />
    <SolidColorBrush x:Key="ApeControlFillDisabled" Color="#F3F3F3" />
    <SolidColorBrush x:Key="ApeControlFillInputActive" Color="#FFFFFF" />

    <!-- 文字 -->
    <SolidColorBrush x:Key="ApeTextFillPrimary" Color="#1B1B1B" />
    <SolidColorBrush x:Key="ApeTextFillSecondary" Color="#5C5C5C" />
    <SolidColorBrush x:Key="ApeTextFillTertiary" Color="#9E9E9E" />
    <SolidColorBrush x:Key="ApeTextFillDisabled" Color="#AEAEAE" />
    <SolidColorBrush x:Key="ApeTextFillOnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ApeTextFillOnAccentDisabled" Color="#6BB3E0" />

    <!-- 边框 -->
    <SolidColorBrush x:Key="ApeStrokeDefault" Color="#E5E5E5" />
    <SolidColorBrush x:Key="ApeStrokeSubtle" Color="#EBEBEB" />
    <SolidColorBrush x:Key="ApeStrokeFocus" Color="#005FB8" />
    <SolidColorBrush x:Key="ApeStrokeControlActive" Color="#0067C0" />

    <!-- 强调色 -->
    <SolidColorBrush x:Key="ApeAccentFillDefault" Color="#0067C0" />
    <SolidColorBrush x:Key="ApeAccentFillSecondary" Color="#0078D4" />
    <SolidColorBrush x:Key="ApeAccentFillTertiary" Color="#005FB8" />
    <SolidColorBrush x:Key="ApeAccentFillDisabled" Color="#C7E0F4" />
    <SolidColorBrush x:Key="ApeAccentTextPrimary" Color="#0067C0" />
    <SolidColorBrush x:Key="ApeAccentTextDisabled" Color="#6BB3E0" />

    <!-- 语义色 -->
    <SolidColorBrush x:Key="ApePositiveBrush" Color="#0F7B0F" />
    <SolidColorBrush x:Key="ApeNegativeBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="ApeSpecialBrush" Color="#773BDB" />
    <SolidColorBrush x:Key="ApeFunctionalBrush" Color="#0067C0" />

    <!-- 形状与阴影 -->
    <CornerRadius x:Key="ApeOverlayCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="ApeControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="ApeSmallCornerRadius">2</CornerRadius>

    <!-- 字体 -->
    <FontFamily x:Key="ApeDefaultFontFamily">Segoe UI Variable, Segoe UI</FontFamily>
    <sys:Double x:Key="ApeTitleFontSize" xmlns:sys="clr-namespace:System;assembly=mscorlib">24</sys:Double>
    <sys:Double x:Key="ApeCaptionFontSize" xmlns:sys="clr-namespace:System;assembly=mscorlib">20</sys:Double>
    <sys:Double x:Key="ApeBodyFontSize" xmlns:sys="clr-namespace:System;assembly=mscorlib">14</sys:Double>
    <sys:Double x:Key="ApeCaptionTextFontSize" xmlns:sys="clr-namespace:System;assembly=mscorlib">12</sys:Double>
    <sys:Double x:Key="ApeSubtextFontSize" xmlns:sys="clr-namespace:System;assembly=mscorlib">12</sys:Double>

</ResourceDictionary>
