<Window x:Class="ApeFree.ApeDialogs.WPF.Hosting.DialogHostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ApeDialogs"
        Width="480" Height="300"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Transparent"
        FontFamily="{DynamicResource ApeDefaultFontFamily}"
        TextOptions.TextFormattingMode="Display"
        KeyboardNavigation.TabNavigation="Cycle"
        KeyboardNavigation.DirectionalNavigation="Cycle">

    <Border x:Name="RootBorder"
            Margin="20"
            Background="{DynamicResource ApeWindowBackground}"
            BorderBrush="{DynamicResource ApeStrokeDefault}"
            BorderThickness="1"
            CornerRadius="8"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="6" Direction="270" Opacity="0.25" Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏（可拖动） -->
            <Grid x:Name="TitleBarGrid" Grid.Row="0" Margin="24,16,16,8" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TitleTextBlock"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           FontSize="{DynamicResource ApeTitleFontSize}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ApeTextFillPrimary}"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" />

                <Button x:Name="CloseButton"
                        Grid.Column="1"
                        Width="32" Height="32"
                        Margin="8,0,0,0"
                        Padding="0"
                        ToolTip="Close"
                        Style="{DynamicResource ApeIconButtonStyle}"
                        Click="CloseButton_Click">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                               Foreground="{DynamicResource ApeTextFillPrimary}" />
                </Button>
            </Grid>

            <!-- 内容区（直接承载，保留天然测量边界以支持 ListView/DataGrid 的 UI 虚拟化） -->
            <ContentControl x:Name="ContentPresenter"
                            Grid.Row="1"
                            Margin="24,8,24,0" />

            <!-- 选项区 -->
            <StackPanel x:Name="OptionsPanel"
                        Grid.Row="2"
                        Margin="24,20,24,24"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal" />
        </Grid>
    </Border>
</Window>
