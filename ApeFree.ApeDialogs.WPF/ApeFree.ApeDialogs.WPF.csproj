<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net452;net461;net472;net6.0-windows;net8.0-windows;net10.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <Company>ApeFree</Company>
    <Authors>Guijie Lee</Authors>
    <Copyright>Copyright © 2022-2026 ApeFree, All Rights Reserved.</Copyright>
    <Title>ApeDialogs.WPF</Title>
    <Product>ApeFree.ApeDialogs.WPF</Product>
    <Description>ApeDialogs 的 WPF 实现库（Win11 Fluent 设计风格）。同时支持 WPF 与 WinForms 宿主（需搭配 ApeFree.ApeDialogs.WPF.WinForms 桥包）。</Description>
    <RepositoryUrl>https://github.com/ApeFree/ApeFree.ApeDialogs</RepositoryUrl>
    <PackageProjectUrl>https://github.com/ApeFree/ApeFree.ApeDialogs</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>ApeFree_64px.png</PackageIcon>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>

    <Version>1.1.0.0-alpha61112</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <Deterministic>true</Deterministic>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- CA1510: ThrowIfNull 在 net461 不存在；CA1707: Windows 版本名带下划线为有意命名；SYSLIB1054: LibraryImport 在 net7+，net461 需 DllImport -->
    <NoWarn>$(NoWarn);1591;CA1510;CA1707;SYSLIB1054</NoWarn>
		<GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">true</GeneratePackageOnBuild>
	</PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net461' Or '$(TargetFramework)' == 'net452'">
    <PackageReference Include="System.ValueTuple" Version="4.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ApeFree.ApeDialogs\ApeFree.ApeDialogs.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ApeFree.ApeDialogs.WPF.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\ApeFree_64px.png" Pack="true" PackagePath="\" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>