<UserControl x:Class="ApeFree.ApeDialogs.WPF.Controls.ApeColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ApeFree.ApeDialogs.WPF.Controls">

    <StackPanel>
        <!-- SV 面板 + 色相条 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <controls:ApeSaturationValuePanel x:Name="SVPanel" Height="180" />

            <controls:ApeHueBar x:Name="HueBar" Width="20" Height="180" Margin="8,0,0,0" Grid.Column="1" />
        </Grid>

        <!-- 预览 + RGB 数值输入 -->
        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border x:Name="PreviewSwatch"
                    Width="36" Height="36"
                    CornerRadius="6"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource ApeStrokeDefault}"
                    VerticalAlignment="Center" />

            <Grid Grid.Column="1" Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="R" VerticalAlignment="Center" Margin="0,0,4,0"
                           FontSize="12" Foreground="{DynamicResource ApeTextFillSecondary}" />
                <controls:ApeNumericUpDown x:Name="RedBox" Grid.Column="1" Width="64" Height="28" Margin="0,0,12,0" Minimum="0" Maximum="255" DecimalPlaces="0" />

                <TextBlock Grid.Column="2" Text="G" VerticalAlignment="Center" Margin="0,0,4,0"
                           FontSize="12" Foreground="{DynamicResource ApeTextFillSecondary}" />
                <controls:ApeNumericUpDown x:Name="GreenBox" Grid.Column="3" Width="64" Height="28" Margin="0,0,12,0" Minimum="0" Maximum="255" DecimalPlaces="0" />

                <TextBlock Grid.Column="4" Text="B" VerticalAlignment="Center" Margin="0,0,4,0"
                           FontSize="12" Foreground="{DynamicResource ApeTextFillSecondary}" />
                <controls:ApeNumericUpDown x:Name="BlueBox" Grid.Column="5" Width="64" Height="28" Minimum="0" Maximum="255" DecimalPlaces="0" />
            </Grid>

            <controls:ApeTextBox x:Name="HexBox" Grid.Column="2" Width="108" Height="28"
                                 VerticalAlignment="Center" PlaceholderText="#RRGGBB" />
        </Grid>

        <!-- Alpha 滑块 -->
        <Grid x:Name="AlphaRow" Margin="0,10,0,0" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Alpha" VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource ApeTextFillSecondary}" />
            <controls:ApeSlider x:Name="AlphaSlider" Grid.Column="1" Margin="12,0,0,0" Minimum="0" Maximum="255" Value="255" />
        </Grid>

        <!-- 预设色块 -->
        <WrapPanel x:Name="PresetsPanel" Margin="0,10,0,0" />
    </StackPanel>
</UserControl>
